# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — segredos nunca vão para o repositório
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dados locais do CINEMORPH (banco SQLite, vídeos enviados, renders)
/.data/

# arquivos privados e mídia local
/private/
/uploads/
/tmp/
*.key
*.mp4
*.mov
*.webm

# editores
.vscode/*
!.vscode/extensions.json
.idea/
