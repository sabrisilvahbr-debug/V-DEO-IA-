# Copie para .env.local e ajuste. Nunca faça commit de .env.local.
# Nenhuma variável é obrigatória no modo local.

# ---------------------------------------------------------------- Modo de execução
# local    = SQLite + pasta local, sem login (padrão)
# supabase = PostgreSQL + Auth + Storage do Supabase (veja docs/supabase.md)
CINEMORPH_BACKEND=local

# Pasta dos dados locais (banco, mídias, temporários). Relativa à raiz do projeto.
CINEMORPH_DATA_DIR=.data

# ---------------------------------------------------------------- FFmpeg
# Caminhos dos binários, se não estiverem no PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# ---------------------------------------------------------------- Limites de mídia
MAX_UPLOAD_MB=500
MAX_VIDEO_SECONDS=600
MAX_RESOLUTION=4096

# ---------------------------------------------------------------- Provedores e custos
# Provedor MOCK (demonstração sem IA). Desative em produção se não quiser exibi-lo.
MOCK_PROVIDER_ENABLED=true
# Orçamento mensal para operações pagas, em centavos de dólar. 0 = nenhuma operação paga permitida.
OPERATIONAL_BUDGET_CENTS=0

# ---------------------------------------------------------------- Supabase (somente com CINEMORPH_BACKEND=supabase)
# Valores PÚBLICOS: URL do projeto e chave publicável.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRETA: usada só pelo worker. Nunca use o prefixo NEXT_PUBLIC_ nesta chave.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=media
